{
  "name": "@hyprune/schema",
  "version": "0.11.0",
  "description": "Versioned JSON Schemas for Hyprune world packages and the IPC protocol, with a validator and CLI for world authors",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "hyprune",
    "hyprland",
    "json-schema",
    "world",
    "ipc",
    "validator"
  ],
  "homepage": "https://hyprune.com/reference/schema/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyprune/schema.git"
  },
  "bugs": {
    "url": "https://github.com/hyprune/schema/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./lib/validate.d.mts",
      "import": "./lib/validate.mjs"
    },
    "./package.json": "./package.json",
    "./*.json": "./*.json"
  },
  "bin": {
    "hyprune-validate": "bin/validate.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "v0*/**",
    "extensions/",
    "registry/",
    "examples/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node bin/validate.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "spdx-expression-parse": "4.0.0"
  }
}
